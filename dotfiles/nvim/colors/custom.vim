" Nvim theme - Adventure bg + Night Owl colors
set background=dark
set termguicolors

" Adventure background - pure black
highlight Normal guifg=#d6d6d6 guibg=#000000
highlight NonText guibg=#000000 guifg=#404040

" Night Owl syntax colors
highlight String guifg=#ecc48d
highlight Comment guifg=#637777 gui=italic
highlight Keyword guifg=#c792ea
highlight Function guifg=#82aaff
highlight Type guifg=#7ec699
highlight Number guifg=#f78c6b
highlight Statement guifg=#c792ea
highlight PreProc guifg=#c792ea
highlight Identifier guifg=#d7d7d7
highlight Special guifg=#f78c6b

" UI elements
highlight LineNr guifg=#464646 guibg=#1a1a1a
highlight CursorLine guibg=#262626
highlight VertSplit guifg=#333333 guibg=#1a1a1a
highlight StatusLine guibg=#262626 guifg=#d6d6d6
highlight Visual guibg=#404040

" Cursor
highlight Cursor guibg=#ffaa00 guifg=#1a1a1a
