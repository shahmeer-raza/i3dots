{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/shahmeer/i3dots/dotfiles/fastfetch/ascii_art.txt",
    "color": {
      "1": "38;2;228;154;107",
      "2": "38;2;240;184;119",
      "3": "38;2;26;35;64",
      "4": "38;2;200;89;64",
      "5": "38;2;240;230;213",
      "6": "38;2;86;97;120",
      "7": "38;2;228;154;107",
      "9": "reset_"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "bar": {
      "char": {
        "elapsed": "/",
        "total": "/"
      },
      "width": 20
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;86;97;120",
        "yellow": "38;2;228;154;107",
        "red": "38;2;200;89;64"
      },
      "ndigits": 2
    },
    "key": {
      "width": 15
    },
    "color": "38;2;228;154;107",
    "separator": " ~> "
  },
  "modules": [
	
    {
      "format": "break",
      "type": "title",
      "format": "{6}{7}{#1}{8}{#}"
    },
    "separator",
    {
      "type": "os",
      "format": "{#4}{4}{#} {?6}({#1}{6}{#}){?} {?12}{12}{?}"
    },
    {
      "type": "localip",
      "showIpv6": false,
      "showMac": false,
      "compact": true
    },
    "shell",
    "break",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "disk"
    },
    "break",
  ]
}
