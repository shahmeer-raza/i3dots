{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "color": {
      "1": "red",
      "2": "yellow",
      "3": "green",
      "4": "light_red",
      "5": "light_yellow",
      "6": "light_green",
      "7": "red",
      "9": "reset_"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "bar": {
      "char": {
        "elapsed": "/",
        "total": "/"
      },
      "width": 20
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red"
      },
      "ndigits": 2
    },
    "key": {
      "width": 15
    },
    "color": "yellow",
    "separator": " ~> "
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    {
      "type": "title",
      "format": "{6}{7}{#yellow}{8}{#}"
    },
    "separator",
    {
      "type": "os",
      "format": "{#red}{4}{#} {?6}({#yellow}{6}{#}){?} {?12}{12}{?}"
    },
    {
      "type": "localip",
      "showIpv6": false,
      "showMac": false,
      "compact": true
    },
    "shell",
    "break",
    "uptime",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    "break",
    {
      "type": "disk"
    },
    "break",
    {
      "type": "media",
      "format": "{5}: <{#underline_yellow}{1}{#}> {?3}by {#1}{3}{#}{?}"
    },
    {
      "type": "sound"
    },
    "break",
    "colors"
  ]
}
